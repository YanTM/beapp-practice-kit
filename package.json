{
  "name": "beapp-practice-planner",
  "version": "1.1.0",
  "description": "Zero-dependency helpers for short Brain Exercise App sessions, exercise instructions, and manual result CSV exports.",
  "main": "planner.js",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "check": "node --check planner.js && node --check app.js && node --check index.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "homepage": "https://brainexerciseapp.com/",
  "repository": {
    "type": "git",
    "url": "https://github.com/YanTM/beapp-practice-kit.git"
  },
  "files": [
    "planner.js",
    "index.mjs",
    "index.d.ts",
    "index.d.mts",
    "API.md",
    "guide.md",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "brain-exercise-app",
    "practice-planner",
    "session-planning",
    "csv",
    "memory",
    "attention",
    "reaction-time",
    "typescript"
  ],
  "module": "index.mjs",
  "types": "index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.mts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./planner.js"
      }
    },
    "./package.json": "./package.json"
  },
  "author": "Digital Development Lab",
  "bugs": {
    "url": "https://github.com/YanTM/beapp-practice-kit/issues"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  }
}
